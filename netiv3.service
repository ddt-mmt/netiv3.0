[Unit]
Description=Neti V3 Flask Application
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/usr/lib/gemini-cli/netiv3/netiV3
ExecStart=/usr/lib/gemini-cli/netiv3/netiV3/venv/bin/gunicorn --workers 1 --bind 0.0.0.0:5004 --timeout 600 run:app
Restart=always

[Install]
WantedBy=multi-user.target
